{
  "name": "pda-bliss-solutions",
  "version": "1.0.0",
  "description": "PDA BLISS SOLUTIONS - Full-Stack Business Website",
  "private": true,
  "scripts": {
    "install": "npm run install:root && npm run install:frontend && npm run install:backend",
    "install:root": "npm install --ignore-scripts",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
